# YowlChat environment template
# Copy this file to ".env" and replace every placeholder value.

# Use "split" when you want two Supabase projects:
# 1) accounts
# 2) core (chats + media)
DATABASE_PROVIDER="split"

# Paste the full connection strings from Supabase > Project Settings > Database > Connection string
SUPABASE_ACCOUNTS_DATABASE_URL="PASTE_ACCOUNTS_SUPABASE_CONNECTION_STRING_HERE"
SUPABASE_CORE_DATABASE_URL="PASTE_CORE_SUPABASE_CONNECTION_STRING_HERE"

# Optional but recommended: project URLs + service role keys so the server can read SMTP config via Supabase REST
SUPABASE_ACCOUNTS_URL="PASTE_ACCOUNTS_SUPABASE_PROJECT_URL_HERE"
SUPABASE_ACCOUNTS_SERVICE_ROLE_KEY="PASTE_ACCOUNTS_SUPABASE_SERVICE_ROLE_KEY_HERE"
SUPABASE_CORE_URL="PASTE_CORE_SUPABASE_PROJECT_URL_HERE"
SUPABASE_CORE_SERVICE_ROLE_KEY="PASTE_CORE_SUPABASE_SERVICE_ROLE_KEY_HERE"
SUPABASE_URL="PASTE_SUPABASE_PROJECT_URL_HERE"
SUPABASE_SERVICE_ROLE_KEY="PASTE_SUPABASE_SERVICE_ROLE_KEY_HERE"

# Auth
JWT_ACCESS_SECRET="CHANGE_ME_ACCESS"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH"
JWT_ISSUER="yowlchat"
JWT_AUDIENCE="yowlchat-users"

# Email delivery for account verification and password reset
SMTP_URL="smtp://no-reply%40yowl.chat:CHANGE_ME_SMTP_PASSWORD@smtp.your-provider.com:587"
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="no-reply@yowl.chat"
SMTP_PASSWORD="CHANGE_ME_SMTP_PASSWORD"
SMTP_FROM="YowlChat <no-reply@yowl.chat>"

# Server
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Public app config
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
NEXT_PUBLIC_APP_NAME="YowlChat"
NEXT_PUBLIC_PRIMARY_COLOR="#FFFC00"

# Supabase client config for the browser
NEXT_PUBLIC_CHAT_SUPABASE_URL="PASTE_CHAT_SUPABASE_URL_HERE"
NEXT_PUBLIC_CHAT_SUPABASE_ANON_KEY="PASTE_CHAT_SUPABASE_ANON_KEY_HERE"
NEXT_PUBLIC_ACCOUNT_SUPABASE_URL="PASTE_ACCOUNT_SUPABASE_URL_HERE"
NEXT_PUBLIC_ACCOUNT_SUPABASE_ANON_KEY="PASTE_ACCOUNT_SUPABASE_ANON_KEY_HERE"

# Supabase Storage uploads
SUPABASE_STORAGE_BUCKET="yowl-media"
