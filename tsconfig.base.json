{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@yowl/types": ["packages/types/src"],
      "@yowl/types/*": ["packages/types/src/*"],
      "@yowl/ui": ["packages/ui/src"],
      "@yowl/ui/*": ["packages/ui/src/*"],
      "@yowl/config": ["packages/config/src"],
      "@yowl/config/*": ["packages/config/src/*"]
    }
  }
}
